          "source_type": { "type": "string", "enum": ["SOURCE_TITLE", "SOURCE_DESCRIPTION", "SOURCE_JSON_FIELD", "SOURCE_IMAGE", "SOURCE_FILE", "HUMAN_CONFIRMATION"] },
          "source_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path"],
            "properties": {
              "relative_path": { "type": "string", "minLength": 1 },
              "json_pointer": { "type": ["string", "null"] },
              "image_id": { "type": ["string", "null"] },
              "region": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
