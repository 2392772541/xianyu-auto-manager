{
  "": "source-product.schema.json",
  "title": "SourceProduct",
  "description": "只读原始采集商品快照，作为后续理解、重制与溯源的不可变根源",
  "type": "object",
  "required": [
    "source_product_id",
    "source_url",
    "source_title",
    "source_description",
    "source_images",
    "source_price",
    "captured_at",
    "archive_manifest_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "source_product_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{6,64}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "source_images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "position",
          "file_name",
          "sha256",
          "width",
          "height"
        ],
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "file_name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "original_url": {
            "type": "string"
          }
        }
      }
    },
    "source_price": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "default": "CNY"
        }
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "archive_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}