{
  "": "sellable-offer.schema.json",
  "title": "SellableOffer",
  "description": "我方实际可售商品与履约包，与同行参考页面严格物理隔离",
  "type": "object",
  "required": [
    "offer_id",
    "source_product_id",
    "actual_contents",
    "fulfillment_type",
    "fulfillment_assets",
    "rights_status",
    "quantity_verified",
    "deliverable_verified",
    "fulfillment_status",
    "human_confirmed"
  ],
  "additionalProperties": false,
  "properties": {
    "offer_id": {
      "type": "string",
      "pattern": "^offer_[a-zA-Z0-9_-]{8,32}$"
    },
    "source_product_id": {
      "type": "string"
    },
    "actual_contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_name",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "item_name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "remarks": {
            "type": "string"
          }
        }
      }
    },
    "fulfillment_type": {
      "": "enums.schema.json#/definitions/DeliveryType"
    },
    "fulfillment_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_type",
          "location_reference"
        ],
        "additionalProperties": false,
        "properties": {
          "asset_type": {
            "type": "string",
            "enum": [
              "NETDISK_LINK",
              "CARD_KEY_POOL",
              "LOCAL_ARCHIVE",
              "SERVICE_ACCOUNT"
            ]
          },
          "location_reference": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "rights_status": {
      "": "enums.schema.json#/definitions/RightsStatus"
    },
    "quantity_verified": {
      "type": "boolean"
    },
    "deliverable_verified": {
      "type": "boolean"
    },
    "fulfillment_status": {
      "": "enums.schema.json#/definitions/FulfillmentStatus"
    },
    "human_confirmed": {
      "type": "boolean"
    },
    "confirmed_by": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}